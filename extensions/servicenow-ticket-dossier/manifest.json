{
  "manifest_version": 3,
  "name": "RiskRegister Browser Sync",
  "short_name": "RR Sync",
  "version": "1.2.1",
  "description": "Automatically starts authorized RiskRegister read-only SharePoint syncs and ServiceNow ticket-packet exports.",
  "author": "RiskRegister",
  "minimum_chrome_version": "109",
  "permissions": [
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://servicenow.adventhealth.com/*",
    "https://*.service-now.com/*",
    "https://*.sharepoint.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RiskRegister Browser Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/RiskRegister/*",
        "http://localhost/riskregister/*",
        "http://127.0.0.1/RiskRegister/*",
        "http://127.0.0.1/riskregister/*"
      ],
      "js": [
        "riskregister-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://servicenow.adventhealth.com/*",
        "https://*.service-now.com/*"
      ],
      "js": [
        "servicenow-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.sharepoint.com/*"
      ],
      "js": [
        "sharepoint-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
